# Segredos e configuracoes locais
.env
.env.*
!.env.example

# Dependencias reproduziveis
/vendor/

# Arquivos gerados em execucao
/storage/cache/*
/storage/logs/*
/storage/temp/*
/storage/uploads/*
/uploads/*
!/storage/cache/.gitkeep
!/storage/logs/.gitkeep
!/storage/temp/.gitkeep
!/storage/uploads/.gitkeep
!/uploads/.gitkeep

# Testes e cobertura
/.phpunit.cache/
/.phpunit.result.cache
/coverage/

# Arquivos internos de planejamento/handoff local
/contexto_projeto.txt
/planejamento.txt
/melhorias.txt
/resultado_dos_testes.txt
/roteiro_definitivo_para_apresentacao.txt
/Comunicação/Melhorias.txt

# Referencias temporarias usadas durante desenvolvimento visual
/.codex_ref*/

# IDE e sistema operacional
/.idea/
/.vscode/
.DS_Store
Thumbs.db
Desktop.ini
